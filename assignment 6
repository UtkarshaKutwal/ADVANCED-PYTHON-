#include <iostream>
#include <vector>
using namespace std;

int knapsackBottomUp(vector<int> weight, vector<int> value, int capacity)
{
    int n = weight.size();

    // DP table
    vector<vector<int>> dp(n + 1, vector<int>(capacity + 1, 0));

    for (int i = 1; i <= n; i++)
    {
        for (int w = 1; w <= capacity; w++)
        {
            if (weight[i - 1] <= w)
            {
                dp[i][w] = max(
                    value[i - 1] + dp[i - 1][w - weight[i - 1]],
                    dp[i - 1][w]
                );
            }
            else
            {
                dp[i][w] = dp[i - 1][w];
            }
        }
    }

    return dp[n][capacity];
}

int main()
{
    vector<int> weight = {10, 20, 30};
    vector<int> value = {60, 100, 120};

    int capacity = 50;

    cout << "Maximum Value = "
         << knapsackBottomUp(weight, value, capacity);

    return 0;
}


#include <iostream>
#include <vector>
using namespace std;

int solve(int n, int capacity, vector<int>& weight,
          vector<int>& value, vector<vector<int>>& dp)
{
    // Base condition
    if (n == 0 || capacity == 0)
        return 0;

    // Already calculated
    if (dp[n][capacity] != -1)
        return dp[n][capacity];

    // If current item can be included
    if (weight[n - 1] <= capacity)
    {
        dp[n][capacity] = max(
            value[n - 1] + solve(n - 1,
                                  capacity - weight[n - 1],
                                  weight, value, dp),
            solve(n - 1, capacity, weight, value, dp)
        );
    }
    else
    {
        // Cannot include current item
        dp[n][capacity] =
            solve(n - 1, capacity, weight, value, dp);
    }

    return dp[n][capacity];
}

int main()
{
    vector<int> weight = {10, 20, 30};
    vector<int> value = {60, 100, 120};

    int capacity = 50;
    int n = weight.size();

    vector<vector<int>> dp(n + 1,
                           vector<int>(capacity + 1, -1));

    cout << "Maximum Value = "
         << solve(n, capacity, weight, value, dp);

    return 0;
}
