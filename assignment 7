        print(email, "-> INVALID")


# Take email input from the user
print("\n======================================")
print("       CHECK YOUR EMAIL")
print("======================================")

user_email = input("Enter an email address: ")

if is_valid_email(user_email):
    print("Result: VALID EMAIL")
else:
    print("Result: INVALID EMAIL")


